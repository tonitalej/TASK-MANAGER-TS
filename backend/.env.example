# Copy to .env and fill in. NEVER commit .env. Placeholders only in this file.
# Every variable is validated at startup (src/config/env.ts); the server refuses to start if one is invalid.

NODE_ENV=development              # development | test | production
PORT=3000                         # 1-65535

# The real database (local PostgreSQL or Supabase: dashboard > Connect).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false                # true for Supabase

# A SEPARATE database used only by "npm test", "npm run db:test:setup" and "npm run start:testdb".
# Must NOT be the same database as DATABASE_URL (the tests refuse to run if it is).
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE
TEST_DATABASE_SSL=false           # optional, defaults to DATABASE_SSL

# Generate without printing it on screen, e.g. in PowerShell:
#   node -e "require('fs').appendFileSync('.env', 'JWT_SECRET=' + require('crypto').randomBytes(48).toString('hex') + '\n')"
# At least 32 characters in production (16 elsewhere).
JWT_SECRET=
JWT_EXPIRES_IN=1h                 # seconds, or 15m / 1h / 7d. Keep it short.
BCRYPT_ROUNDS=10                  # 10-14 (each +1 doubles the hashing time)

# Comma-separated list of frontend origins allowed to call the API from a browser (no "*", no path).
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info                    # fatal | error | warn | info | debug | trace | silent

# Brute-force protection on POST /api/auth/login and /api/auth/register (per client IP).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
