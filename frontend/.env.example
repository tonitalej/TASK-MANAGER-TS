# Copy to .env if you need to change it. Everything starting with VITE_ is PUBLIC:
# it is compiled into the JavaScript bundle, so never put a secret here.

# Base URL of the Express API, without a trailing slash.
# Development: leave EMPTY. The Vite dev server proxies /api to http://localhost:3000.
# Production (API on another origin): e.g. https://api.example.com
#   and add the frontend's origin to CORS_ORIGIN in backend/.env.
VITE_API_URL=
